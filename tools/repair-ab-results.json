    "attempt": 5,
    "strategies": [],
    "planned": false,
    "replans": null,
    "text": "你真好，送朋友去医院。我每天坐公交车去学校。你朋友怎么了？"
   },
   "pln": {
    "end": "clean",
    "attempt": 1,
