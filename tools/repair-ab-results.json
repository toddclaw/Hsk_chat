   "base": {
    "end": "clean",
    "attempt": 1,
    "strategies": [],
    "planned": false,
    "replans": null,
    "text": "你今天开车送朋友去医院了，对吗？我坐公交车去的医院。朋友怎么了？"
   },
   "pln": {
    "end": "stub",
